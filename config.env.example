# vinylcast configuration — copy to /etc/vinylcast/config.env and edit.
# Every service reads this file (systemd EnvironmentFile).

# ── Bluetooth turntable ───────────────────────────────────────────────────
# Your turntable's Bluetooth MAC. Find it with:  bluetoothctl devices
BT_MAC="AA:BB:CC:DD:EE:FF"

# ── This Pi ───────────────────────────────────────────────────────────────
# The Pi's LAN IP — network speakers fetch the stream from here.
# Give the Pi a static/reserved IP so this never changes.
PI_IP="192.168.1.50"

# ── Local Icecast (runs on this Pi) ───────────────────────────────────────
ICECAST_PORT="8005"
ICECAST_SOURCE_PW="CHANGE_ME"        # must match <source-password> in icecast.xml
LIVE_MOUNT="live"                     # the mount your speakers play (no leading slash)

# ── Audio detection ───────────────────────────────────────────────────────
SAMPLE_RATE="48000"
SILENCE_SEC="15"                      # seconds of silence before it stops (time to flip a record)
SILENCE_THRESH_DB="-40dB"             # anything above this = "playing"

# ── Optional intro / DJ drop ──────────────────────────────────────────────
# Path to a raw S16_LE 48000Hz stereo clip played once before the vinyl.
# Leave empty for none.  Make one with:
#   ffmpeg -i intro.wav -f s16le -ar 48000 -ac 2 intro.raw
INTRO_RAW=""

# ── Network speaker (Sonos) ───────────────────────────────────────────────
# IP of the speaker (for a Sonos stereo pair, the COORDINATOR).
# Reserve this IP in your router too.
SPEAKER_IP="192.168.1.100"
