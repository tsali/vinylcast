[Unit]
Description=vinylcast — silence-aware turntable -> Icecast LIVE stream
After=network-online.target icecast2.service bluealsa.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/vinylcast/config.env
ExecStart=/usr/bin/python3 /opt/vinylcast/vinyl-controller.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
