[Unit]
Description=vinylcast — keep the network speaker pinned to the LIVE stream
After=network-online.target vinylcast-controller.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/vinylcast/config.env
ExecStart=/usr/bin/python3 /opt/vinylcast/sonos-keepalive.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
